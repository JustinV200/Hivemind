diff --git a/packages/hivemind/src/hivemind/cli/in_cell/redial.py b/packages/hivemind/src/hivemind/cli/in_cell/redial.py
new file mode 100644
index 0000000..a3855d9
--- /dev/null
+++ b/packages/hivemind/src/hivemind/cli/in_cell/redial.py
@@ -0,0 +1,153 @@
+"""Define RedialLink: the in-Cell Warden's link to the Queen, dialled afresh whenever it drops.
+
+A Virtual Cell's Warden holds one outbound connection to the Queen (ADR-0027), and nothing keeps
+that connection through a pause: Overwintering `docker pause`s the Cell (ADR-0029), the link's own
+keepalive (`waggle.transport.websocket`: a ping after 20 s of quiet, 20 s to answer it) fails it
+about 40-47 s in, and the Queen detaches the Warden. The resumed Warden never noticed: its link
+had simply ended, so the Queen could not reuse the Cell and tore it down for a fresh one. ADR-0004
+keeps reconnecting in the caller, and this is the caller. `receive` notices the drop (it is the
+one reader, always waiting on the link), dials afresh and re-announces the Cell with `handshake`
+-- the `CellReady`, `CapacityReport` and `CellHeartbeat` its first connection opened with, which
+the Queen's readiness gate waits for -- then reads on, so the Queen attaches the same Warden again
+and a Cell Overwintered for any length is reused. A clean close (the Queen ending the link on
+purpose) ends the stream and is never redialled.
+
+Fits into the Hive:
+    Layer 7 (edges: HTTP, terminal, dashboard), inside `hivemind.cli.in_cell`. Built by
+    `hivemind.cli.in_cell.main` around the Cell's own `WebSocketClientTransport` and handed to the
+    Warden as `WardenDeps.queen_link`; the Warden, its trail sync and its snapshot relay all use
+    it as a plain `waggle.transport.base.Transport`. Calls into `hivemind.common.logging` and
+    waggle (clock, envelope, errors, transport) only.
+
+Key invariants:
+    - The handshake's frames are the first on every fresh connection: nothing is sent while a
+      redial is under way (one lock guards both), so the Queen's gate never drops a frame sent
+      between them.
+    - One redial per dropped connection, by the reader alone: a send that meets the drop waits,
+      at most `SEND_WAIT_S`, for the reader's fresh connection and goes out once more on it, or
+      raises `TransportClosedError` (the link is gone for now, as a heartbeat already handles).
+    - A Queen that cannot be reached is dialled again every `REDIAL_PAUSE_S` for as long as the
+      Warden reads: its link to her is the only one it has, and a cancelled read stops it.
+
+See Also:
+    - docs/adr/0004-waggle-transport-websocket-json.md for why reconnect stays in the caller.
+    - docs/adr/0029-overwintering-policy.md for the pause this link outlives.
+    - hivemind.cli.in_cell.link for the three frames the handshake sends.
+    - hivemind.queen.cell_gate.provider for the Queen's side: a resumed Cell whose link died is
+      waited for afresh.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import AsyncIterator, Awaitable, Callable
+
+from hivemind.common.logging import get_logger
+from waggle.clock import Clock
+from waggle.envelope import Envelope
+from waggle.errors import ConnectFailedError, ConnectionLostError, TransportClosedError
+from waggle.transport.base import Transport
+
+REDIAL_PAUSE_S = 30.0  # Between rounds of dial attempts once a whole round failed (a Queen away).
+SEND_WAIT_S = 10.0  # The longest a send that met a drop waits for the reader's fresh connection.
+
+# Connects the wrapped transport and sends the Cell's announcement frames on it, in order.
+Handshake = Callable[[], Awaitable[None]]
+
+__all__ = ["REDIAL_PAUSE_S", "SEND_WAIT_S", "Handshake", "RedialLink"]
+
+_LOG = get_logger(__name__)
+
+
+class RedialLink:
+    """A `Transport` over one client transport that is dialled afresh whenever its link drops.
+
+    Owns its own small mutable state in place (codingrules section 8.5, documented): the count of
+    connections made so far, which a redial advances, and the condition sends wait on for it.
+    """
+
+    def __init__(self, real: Transport, handshake: Handshake, clock: Clock) -> None:
+        """Wrap `real`, already connected and announced by one `handshake` call.
+
+        Args:
+            real: The Cell's own client transport; `connect` dials it afresh after a drop.
+            handshake: Connects `real` and sends the Cell's announcement frames through it
+                (never through this link, whose lock a redial already holds).
+            clock: Paces the pause between rounds of dial attempts.
+        """
+        self._real = real
+        self._handshake = handshake
+        self._clock = clock
+        self._connections = 1  # The one the caller's own handshake opened.
+        self._changed = asyncio.Condition()  # Guards every send and every redial alike.
+
+    @property
+    def is_connected(self) -> bool:
+        """See `Transport.is_connected`: the current connection's own state."""
+        return self._real.is_connected
+
+    async def connect(self) -> None:
+        """See `Transport.connect`: forwarded (the caller's handshake already connected it)."""
+        await self._real.connect()
+
+    async def send(self, envelope: Envelope) -> None:
+        """Send `envelope`; one that meets a drop goes out once more on the fresh connection.
+
+        Raises:
+            TransportClosedError: The link was closed, or no fresh connection came within
+                `SEND_WAIT_S` (the Queen is unreachable for now; the reader keeps dialling).
+            FrameTooLargeError: The frame would exceed the codec's limit; nothing was sent.
+        """
+        async with self._changed:
+            seen = self._connections
+            try:
+                await self._real.send(envelope)
+                return
+            except ConnectionLostError:
+                pass  # The reader notices the same drop and redials; wait for its connection.
+            try:
+                # Bounded: a Queen that stays away must not hold the Warden's own tick.
+                async with asyncio.timeout(SEND_WAIT_S):
+                    await self._changed.wait_for(lambda: self._connections != seen)
+            except TimeoutError as exc:
+                raise TransportClosedError(
+                    f"The link to the Queen dropped and was not redialled within {SEND_WAIT_S}s."
+                ) from exc
+            await self._real.send(envelope)
+
+    async def receive(self) -> AsyncIterator[Envelope]:
+        """Yield every envelope the Queen sends, across every connection, until a clean close.
+
+        Raises:
+            CodecError | SignatureError: A frame failed to decode (the wrapped transport's own).
+            TransportClosedError: This link was closed while being read.
+        """
+        while True:
+            seen = self._connections
+            try:
+                async for envelope in self._real.receive():
+                    yield envelope
+                return  # A clean close: the Queen ended the link on purpose; never redialled.
+            except ConnectionLostError as exc:
+                _LOG.info("cell.link.dropped", error=str(exc))
+                await self._repair(seen)
+
+    async def close(self) -> None:
+        """See `Transport.close`: forwarded; nothing redials a link closed on purpose."""
+        await self._real.close()
+
+    async def _repair(self, seen: int) -> None:
+        """Dial afresh and re-announce, until it holds, unless a redial already replaced `seen`."""
+        while True:
+            try:
+                async with self._changed:
+                    if self._connections == seen:
+                        await self._handshake()
+                        self._connections += 1
+                        self._changed.notify_all()
+                        _LOG.info("cell.link.redialled", connections=self._connections)
+                return
+            except (ConnectFailedError, ConnectionLostError) as exc:
+                # The Queen is unreachable for now (restarting, say): try again after a pause.
+                _LOG.warning("cell.link.redial_failed", error=str(exc), pause_s=REDIAL_PAUSE_S)
+            await self._clock.sleep(REDIAL_PAUSE_S)
