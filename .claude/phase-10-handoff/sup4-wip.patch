+    async def resume(self, cell_id: CellId) -> None:
+        await super().resume(cell_id)
+        if self.dial_back:
+            # A moment after it runs again, never inside resume() itself: a real Cell's fresh
+            # handshake reaches the Queen only once its Warden noticed the dead link and redialled.
+            self.dial_backs.append(asyncio.ensure_future(self._redial(cell_id)))
+
+    async def _redial(self, cell_id: CellId) -> None:
+        """Attach the Cell's Warden on a fresh link (replacing a dead one), then resolve."""
+        old = self._first_links[cell_id]
+        fresh = dataclasses.replace(old, transport=MemoryTransport.pair(Codec(), Codec())[0])
+        # The listener attaches the same Warden id again: it replaces whatever link it had.
+        self._wardens[:] = [link for link in self._wardens if link.cell.id != cell_id]
+        self._wardens.append(fresh)
+        self._queen_gate.resolve(
+            cell_id,
+            new_node_id(self._clock),
+            CellReadyInfo(capabilities=old.cell.capabilities, capacity=old.cell.capacity),
+        )
