+async def test_an_old_links_end_never_detaches_the_warden_that_dialled_back_in() -> None:
+    # A resumed Cell's Warden redials before the Queen has seen its dead link close: the old
+    # link's own end must leave the fresh one attached.
+    deps, link, _end = make_queen_deps()
+    queen = Queen(deps)
+    await queen.attach_warden(link)
+    fresh = dataclasses.replace(link, transport=MemoryTransport.pair(Codec(), Codec())[0])
+    await queen.attach_warden(fresh)
+
+    await detach_warden(queen, link.warden_id, transport=link.transport)
+    assert [w.transport for w in queen.wardens] == [fresh.transport]
+
+    await detach_warden(queen, link.warden_id, transport=fresh.transport)
+    assert queen.wardens == ()
