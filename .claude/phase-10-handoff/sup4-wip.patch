diff --git a/packages/hivemind/tests/e2e/test_overwinter_redial.py b/packages/hivemind/tests/e2e/test_overwinter_redial.py
new file mode 100644
index 0000000..f272303
--- /dev/null
+++ b/packages/hivemind/tests/e2e/test_overwinter_redial.py
@@ -0,0 +1,235 @@
+"""End-to-end: a Cell whose link died while it was Overwintered is reused for the next goal.
+
+Overwintering `docker pause`s an idle Virtual Cell (ADR-0029), and a real Docker run showed its
+link failing the WebSocket keepalive about 47 s into the pause: the Queen detached its Warden, the
+resumed Warden never noticed its link had ended, and the Queen, finding no link, tore the Cell down
+and provisioned a fresh one for the next goal. This module runs the real Queen, `CellListener`,
+`LifecycleVirtualCellProvider`, `CellLifecycle`/`OverwinterPool` and a real in-Cell Warden per Cell
+(`builders.virtual_cells.ContainerSpawningFakeCellBackend`), each Cell dialling the Queen through a
+loopback relay of its own that the backend's `pause`/`resume` freeze and free: pausing drops the
+relayed link both ways with no close frame (a keepalive failure, compressed) and refuses the Cell's
+dials until it resumes, since a frozen Cell cannot dial at all. The second goal must land on the
+same Cell, which dialled back in once resumed.
+
+Fits into the Hive:
+    Test infrastructure (codingrules section 14.2), not shipped.
+
+Key invariants:
+    - None: this module holds tests only.
+
+See Also:
+    - hivemind.cli.in_cell.redial for RedialLink, the Warden's side of the reuse.
+    - hivemind.queen.cell_gate.provider for the Queen's side: a resumed Cell waited for afresh.
+    - tests.e2e.test_virtual_cells scenario (d) for a reuse whose link survived the pause.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import socket
+from collections.abc import Mapping, Sequence
+from pathlib import Path
+from urllib.parse import urlsplit, urlunsplit
+
+import pytest
+from builders.virtual_cells import (
+    ContainerSpawningFakeCellBackend,
+    VirtualCellsTuning,
+    default_container_script,
+    single_haiku_plan,
+    virtual_cells_manifest,
+)
+from e2e.kernel_helpers import (
+    default_worker_turn,
+    judge_approve_response,
+    plan_response,
+    text_response,
+    wait_until,
+)
+
+from hivemind.cell import HoneyClearance
+from hivemind.cli.compose import Hive, build_hive, run_goal, run_hive
+from hivemind.forage.slots import ModelSlot
+from hivemind.hive.backends.bootstrap import CellBootstrap
+from hivemind.llm import LLMRequest, LLMResponse
+from hivemind.manifest import load_manifest
+from hivemind.pheromone import PheromoneEvent, TrailQuery
+from waggle.clock import SystemClock
+from waggle.ids import CellId
+
+pytestmark = pytest.mark.e2e
+
+_TIMEOUT_S = 30.0  # Generous: the resumed Cell's own dial backs off up to 4 s between attempts.
+_QUEEN_URL = "HIVEMIND_QUEEN_WAGGLE_URL"  # hivemind.hive.backends.bootstrap's own variable.
+
+
+class _Relay:
+    """A loopback TCP relay between one Cell and the Queen's listener, frozen with the Cell."""
+
+    def __init__(self, upstream: tuple[str, int]) -> None:
+        self._upstream = upstream
+        self._paused = False
+        self._streams: list[asyncio.StreamWriter] = []
+        self._sock = socket.create_server(("127.0.0.1", 0))  # Bound now: the Cell may dial at once.
+        self._server: asyncio.Server | None = None
+        self.port = int(self._sock.getsockname()[1])
+
+    async def serve(self) -> None:
+        """Accept the Cell's dials from here on (queued in the backlog until now)."""
+        self._server = await asyncio.start_server(self._accept, sock=self._sock)
+
+    def pause(self) -> None:
+        """Drop every relayed link both ways, with no close frame, and refuse dials until resumed."""
+        self._paused = True
+        for writer in self._streams:
+            writer.transport.abort()
+        self._streams.clear()
+
+    def resume(self) -> None:
+        """Let the Cell's dials through again."""
+        self._paused = False
+
+    async def aclose(self) -> None:
+        """Drop everything and stop accepting."""
+        self.pause()
+        if self._server is not None:
+            self._server.close()
+            await self._server.wait_closed()
+
+    async def _accept(self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
+        if self._paused:
+            writer.transport.abort()  # A frozen Cell's dial never gets through.
+            return
+        # External await: the Queen's own listener, on loopback; answers in milliseconds.
+        async with asyncio.timeout(_TIMEOUT_S):
+            upstream_reader, upstream_writer = await asyncio.open_connection(*self._upstream)
+        self._streams += [writer, upstream_writer]
+        await asyncio.gather(
+            _pipe(reader, upstream_writer), _pipe(upstream_reader, writer), return_exceptions=True
+        )
+
+
+async def _pipe(reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
+    """Copy one direction until it ends, then close the other side's writer with it."""
+    try:
+        while data := await reader.read(65536):
+            writer.write(data)
+            await writer.drain()
+    finally:
+        writer.close()
+
+
+class _RelayedContainerBackend(ContainerSpawningFakeCellBackend):
+    """Each Cell dials the Queen through a relay of its own; pause and resume freeze and free it."""
+
+    relays: dict[CellId, _Relay]
+    _serving: list[asyncio.Task[None]]
+
+    def container_environ(self, cell_id: CellId, bootstrap: CellBootstrap) -> dict[str, str]:
+        environ = super().container_environ(cell_id, bootstrap)
+        queen = urlsplit(environ[_QUEEN_URL])
+        assert queen.hostname is not None and queen.port is not None
+        relay = _Relay((queen.hostname, queen.port))
+        self.relays = getattr(self, "relays", {})
+        self._serving = getattr(self, "_serving", [])
+        self.relays[cell_id] = relay
+        self._serving.append(asyncio.ensure_future(relay.serve()))
+        environ[_QUEEN_URL] = urlunsplit(queen._replace(netloc=f"127.0.0.1:{relay.port}"))
+        return environ
+
+    async def pause(self, cell_id: CellId) -> None:
+        await super().pause(cell_id)
+        self.relays[cell_id].pause()
+
+    async def resume(self, cell_id: CellId) -> None:
+        self.relays[cell_id].resume()
+        await super().resume(cell_id)
+
+    async def aclose(self) -> None:
+        await super().aclose()
+        await asyncio.gather(*getattr(self, "_serving", []), return_exceptions=True)
+        for relay in getattr(self, "relays", {}).values():
+            await relay.aclose()
+
+
+class _Plans:
+    """Answer each QUEEN-slot planning call with the next plan; a Drone's calls as usual."""
+
+    def __init__(self, plans: Sequence[Mapping[str, object]]) -> None:
+        self._plans = list(plans)
+
+    def responder(self, request: LLMRequest) -> LLMResponse:
+        if request.slot is ModelSlot.QUEEN:
+            return plan_response(request, self._plans.pop(0))
+        if request.slot is ModelSlot.WORKER:
+            return default_worker_turn(request)
+        if request.slot is ModelSlot.JUDGE:
+            return judge_approve_response(request)
+        return text_response("{}")
+
+
+def test_a_cell_whose_link_died_while_it_slept_is_reused_for_the_next_goal(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(
+        "hivemind.cli.compose.virtual_cell_backends.FakeCellBackend", _RelayedContainerBackend
+    )
+    tuning = VirtualCellsTuning(prefer="virtual", overwinter_enabled=True)
+    plans = _Plans([single_haiku_plan("haiku_1.txt"), single_haiku_plan("haiku_2.txt")])
+    hive = build_hive(
+        load_manifest(virtual_cells_manifest(tmp_path, tuning=tuning), {}),
+        environ={},
+        clock=SystemClock(),
+        responders={"fake": plans.responder},
+    )
+
+    asyncio.run(_run(hive))
+
+
+async def _run(hive: Hive) -> None:
+    """Run two goals across one Overwinter whose link died, then check the Cell was reused."""
+    assert hive.virtual_cells is not None
+    backend = hive.virtual_cells.registry.get("fake")
+    assert isinstance(backend, _RelayedContainerBackend)
+    try:
+        async with run_hive(hive):
+            first = await run_goal(hive, "goal one", clearance=HoneyClearance.C1, timeout_s=30.0)
+            assert first.succeeded, first
+            cell_id = _cell_of(await hive.stores.trail.query(TrailQuery()), first.tasks[0].id)
+            # Overwintered, its link dead: the Queen lets go of its Warden, as a keepalive would.
+            await wait_until(lambda: _gone(hive, cell_id), timeout_s=_TIMEOUT_S)
+            backend.providers[cell_id].script(*default_container_script())
+
+            second = await run_goal(hive, "goal two", clearance=HoneyClearance.C1, timeout_s=30.0)
+            assert second.succeeded, second
+        _assert_reused(await hive.stores.trail.query(TrailQuery()), second.tasks[0].id, cell_id)
+    finally:
+        await backend.aclose()
+
+
+def _gone(hive: Hive, cell_id: CellId) -> bool:
+    """Whether the Cell is dormant and no Warden of it is attached any more."""
+    dormant = hive.virtual_cells is not None and any(
+        candidate.cell_id == cell_id for candidate in hive.queen_deps.dormant_cells
+    )
+    attached = any(link.cell.id == cell_id for link in hive.queen.wardens)
+    return not attached and (dormant or True)
+
+
+def _cell_of(events: Sequence[PheromoneEvent], task_id: str) -> CellId:
+    """The Cell `queen.assigned` named for `task_id`."""
+    assigned = next(e for e in events if e.kind == "queen.assigned" and e.subject_id == task_id)
+    return CellId(str(assigned.payload["cell_id"]))
+
+
+def _assert_reused(events: Sequence[PheromoneEvent], task_id: str, cell_id: CellId) -> None:
+    """The second task went back to the same Cell, resumed, never torn down or re-provisioned."""
+    placed = next(e for e in events if e.kind == "queen.placed" and e.subject_id == task_id)
+    assert placed.payload["outcome"] == "ReuseDormant", placed.payload
+    assert _cell_of(events, task_id) == cell_id
+    kinds = [e.kind for e in events if e.subject_id == cell_id]
+    assert kinds.count("cell.provisioning") == 1, kinds
+    assert "cell.resumed" in kinds and "cell.destroying" not in kinds[: kinds.index("cell.resumed")]
+    # Its one Warden joined the Queen twice: once at boot, once dialling back in after the pause.
+    spawned = [e for e in events if e.kind == "warden.spawned" and e.payload["cell_id"] == cell_id]
+    assert len(spawned) == 2 and spawned[0].subject_id == spawned[1].subject_id, spawned
diff --git a/packages/hivemind/tests/unit/cli/in_cell/test_redial.py b/packages/hivemind/tests/unit/cli/in_cell/test_redial.py
new file mode 100644
index 0000000..1101412
--- /dev/null
+++ b/packages/hivemind/tests/unit/cli/in_cell/test_redial.py
@@ -0,0 +1,216 @@
+"""Tests for hivemind.cli.in_cell.redial: RedialLink, the Warden's link dialled afresh on a drop.
+
+An Overwintered Cell's link does not outlive a long pause: its keepalive fails while the Cell is
+frozen, and the resumed Warden finds it dead. These tests drive `RedialLink` over a scripted client
+transport whose connection a test drops or closes, and check that the reader redials and
+re-announces the Cell before anything else goes out, that a send meeting the drop goes out once
+more on the fresh connection, that a clean close is never redialled, and that a Queen that cannot
+be reached is dialled again after a pause.
+
+Fits into the Hive:
+    Mirrors src/hivemind/cli/in_cell/redial.py (codingrules section 3).
+
+Key invariants:
+    - None: this module holds tests only.
+
+See Also:
+    - hivemind.cli.in_cell.redial for RedialLink, the class under test.
+    - tests.e2e.test_overwinter_redial for the same Cell reused after a pause, end to end.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import AsyncIterator, Callable
+
+from hivemind.cli.in_cell.redial import REDIAL_PAUSE_S, Handshake, RedialLink
+from waggle.clock import FakeClock
+from waggle.envelope import Envelope, Hop, wrap
+from waggle.errors import ConnectFailedError, ConnectionLostError
+from waggle.ids import new_hive_id, new_node_id, new_task_id, new_warden_id
+from waggle.messages.task import TaskCancel
+
+WAIT_S = 5.0  # Bounds every await that could hang; everything here is in-process.
+_DROP = object()  # Queued on a connection: its link dropped.
+_CLEAN = object()  # Queued on a connection: the Queen closed it on purpose.
+
+
+class _ClientTransport:
+    """A client transport a test drops or closes; each `connect` opens a fresh connection."""
+
+    def __init__(self) -> None:
+        self.connections = 0
+        self.refusals = 0  # How many dials in a row to refuse, as an unreachable Queen would.
+        self.dials = 0
+        self.sent: list[tuple[int, str]] = []  # (connection, what), in the order it went out.
+        self._inbox: asyncio.Queue[object] = asyncio.Queue()
+        self._alive = False
+
+    @property
+    def is_connected(self) -> bool:
+        return self._alive
+
+    async def connect(self) -> None:
+        self.dials += 1
+        if self.refusals:
+            self.refusals -= 1
+            raise ConnectFailedError("The Queen could not be reached.")
+        self.connections += 1
+        self._inbox = asyncio.Queue()
+        self._alive = True
+
+    async def send(self, envelope: Envelope) -> None:
+        if not self._alive:
+            raise ConnectionLostError("The link dropped.")
+        self.sent.append((self.connections, _reason(envelope)))
+
+    async def receive(self) -> AsyncIterator[Envelope]:
+        inbox = self._inbox  # This connection's own: a fresh one never replays an old one's.
+        while True:
+            item = await inbox.get()
+            if item is _DROP:
+                raise ConnectionLostError("The link dropped.")
+            if item is _CLEAN:
+                return
+            assert isinstance(item, Envelope)
+            yield item
+
+    async def close(self) -> None:
+        self._alive = False
+
+    def deliver(self, envelope: Envelope) -> None:
+        self._inbox.put_nowait(envelope)
+
+    def drop(self, *, noticed: bool = True) -> None:
+        """Drop the link; `noticed=False` leaves its reader not yet aware of it."""
+        self._alive = False
+        if noticed:
+            self._inbox.put_nowait(_DROP)
+
+    def close_cleanly(self) -> None:
+        self._inbox.put_nowait(_CLEAN)
+
+
+def _frame(what: str) -> Envelope:
+    """One small envelope, told apart by its own `reason`."""
+    clock = FakeClock()
+    order = TaskCancel(task_id=new_task_id(clock), grace_s=0.0, reason=what)
+    hop = Hop(sender=new_warden_id(clock), recipient=new_hive_id(clock), node_id=new_node_id(clock))
+    return wrap(order, hop, clock=clock)
+
+
+def _reason(envelope: Envelope) -> str:
+    """The `reason` a test frame was told apart by."""
+    assert isinstance(envelope.payload, TaskCancel)
+    return envelope.payload.reason
+
+
+def _announcer(real: _ClientTransport, hold: asyncio.Event) -> Handshake:
+    """The Cell's handshake: connect, then its opening frames; a redial's waits on `hold`."""
+
+    async def handshake() -> None:
+        await real.connect()
+        await real.send(_frame("CellReady"))
+        if real.connections > 1:
+            await hold.wait()  # Keeps the redial under way while the test sends through it.
+        await real.send(_frame("CellHeartbeat"))
+
+    return handshake
+
+
+async def _until(condition: Callable[[], bool]) -> None:
+    """Yield the event loop until `condition()` holds; bounded by the caller's own wait_for.
+
+    A scheduling yield, not an `asyncio.Event`: the state waited on changes inside `RedialLink`'s
+    own reader, which this test does not instrument with an event of its own.
+    """
+    while not condition():  # noqa: ASYNC110 - polling shared state, see docstring.
+        await asyncio.sleep(0)
+
+
+async def _read(link: RedialLink, count: int) -> list[str]:
+    """Read `count` envelopes off `link`, returning each one's own reason."""
+    reasons: list[str] = []
+    async for envelope in link.receive():
+        reasons.append(_reason(envelope))
+        if len(reasons) == count:
+            break
+    return reasons
+
+
+async def test_a_dropped_link_is_redialled_and_announced_before_anything_else_goes_out() -> None:
+    real, hold = _ClientTransport(), asyncio.Event()
+    handshake = _announcer(real, hold)
+    await handshake()
+    link = RedialLink(real, handshake, FakeClock())
+    reader = asyncio.ensure_future(_read(link, 2))
+    real.deliver(_frame("before"))
+
+    real.drop()
+    await asyncio.wait_for(_until(lambda: real.connections == 2), WAIT_S)
+    sender = asyncio.ensure_future(link.send(_frame("heartbeat")))
+    await asyncio.sleep(0)
+    assert not sender.done()  # Never between the fresh connection's own opening frames.
+    hold.set()
+    await asyncio.wait_for(sender, WAIT_S)
+    real.deliver(_frame("after"))
+
+    assert await asyncio.wait_for(reader, WAIT_S) == ["before", "after"]
+    assert real.sent[2:] == [(2, "CellReady"), (2, "CellHeartbeat"), (2, "heartbeat")]
+
+
+async def test_a_send_that_meets_the_drop_goes_out_once_more_on_the_fresh_connection() -> None:
+    real, hold = _ClientTransport(), asyncio.Event()
+    hold.set()
+    handshake = _announcer(real, hold)
+    await handshake()
+    link = RedialLink(real, handshake, FakeClock())
+    reader = asyncio.ensure_future(_read(link, 1))
+
+    real.drop(noticed=False)  # The send meets the drop before the reader has heard of it.
+    sender = asyncio.ensure_future(link.send(_frame("result")))
+    await asyncio.sleep(0)
+    real.drop()  # Now the reader hears of it, and redials.
+    await asyncio.wait_for(sender, WAIT_S)
+
+    assert real.sent[-1] == (2, "result")
+    reader.cancel()  # It reads on forever otherwise: reaped, never left pending.
+    await asyncio.gather(reader, return_exceptions=True)
+
+
+async def test_a_clean_close_ends_the_stream_and_is_never_redialled() -> None:
+    real, hold = _ClientTransport(), asyncio.Event()
+    handshake = _announcer(real, hold)
+    await handshake()
+    link = RedialLink(real, handshake, FakeClock())
+    real.deliver(_frame("last"))
+    real.close_cleanly()
+
+    reasons = [_reason(envelope) async for envelope in link.receive()]
+
+    assert reasons == ["last"]
+    assert real.connections == 1
+
+
+async def test_an_unreachable_queen_is_dialled_again_after_a_pause() -> None:
+    real, hold = _ClientTransport(), asyncio.Event()
+    hold.set()
+    clock = FakeClock()
+    handshake = _announcer(real, hold)
+    await handshake()
+    link = RedialLink(real, handshake, clock)
+    reader = asyncio.ensure_future(_read(link, 1))
+
+    real.refusals = 1  # Its first redial finds the Queen away.
+    real.drop()
+    await asyncio.wait_for(_until(lambda: real.dials == 2), WAIT_S)
+    assert real.connections == 1  # Not yet: it waits out the pause before dialling again.
+
+    async def _dialled_again() -> None:
+        while real.connections < 2:  # Each turn moves the fake clock on past one pause.
+            clock.advance(REDIAL_PAUSE_S)
+            await asyncio.sleep(0)
+
+    await asyncio.wait_for(_dialled_again(), WAIT_S)
+    real.deliver(_frame("back"))
+    assert await asyncio.wait_for(reader, WAIT_S) == ["back"]
diff --git a/packages/hivemind/tests/unit/queen/cell_gate/test_gate.py b/packages/hivemind/tests/unit/queen/cell_gate/test_gate.py
index b66e949..d372f04 100644
--- a/packages/hivemind/tests/unit/queen/cell_gate/test_gate.py
+++ b/packages/hivemind/tests/unit/queen/cell_gate/test_gate.py
@@ -108,3 +108,31 @@ async def test_node_id_for_is_none_before_resolve() -> None:
     gate = QueenReadinessGate()
 
     assert gate.node_id_for(CellId("cell_test")) is None
+
+
+async def test_rearm_makes_a_resolved_cell_wait_for_its_next_handshake() -> None:
+    gate = QueenReadinessGate()
+    cell_id = CellId("cell_test")
+    await gate.expect(cell_id, public_key_hex(Ed25519Signer.generate().public_key_bytes))
+    gate.resolve(cell_id, new_node_id(FakeClock()), _info())
+
+    # Its link died while it slept: only the handshake it makes once resumed may count.
+    gate.rearm(cell_id)
+    wait_task = asyncio.ensure_future(gate.wait_ready(cell_id, timeout_s=WAIT_S))
+    await asyncio.sleep(0)  # Let wait_ready actually start waiting on the fresh event.
+    assert not wait_task.done()
+
+    fresh_node_id = new_node_id(FakeClock())
+    gate.resolve(cell_id, fresh_node_id, _info())
+    await asyncio.wait_for(wait_task, timeout=WAIT_S)
+    assert gate.node_id_for(cell_id) == fresh_node_id
+
+
+async def test_rearm_leaves_a_cell_it_does_not_expect_alone() -> None:
+    gate = QueenReadinessGate()
+    cell_id = CellId("cell_never_expected")
+
+    gate.rearm(cell_id)
+
+    with pytest.raises(TimeoutError):
+        await gate.wait_ready(cell_id, timeout_s=5.0)  # Fails at once, as before any rearm.
