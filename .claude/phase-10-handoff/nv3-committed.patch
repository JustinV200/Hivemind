+title = "a snapshot relay request naming another Cell"
+counts = [{ kind = "guard.relay_refused", where = { reason = ["another_cell"] } }]
+group_by = "cell"
+window_s = 3600.0
+threshold = 1
+confidence = "critical"
+action = "isolate_cell"
+
+# A Warden's message about a task not placed on its Cell (guard.task_refused): a Cell trying to
+# finish, fail, block or report on another Cell's task, or on one placed nowhere. Nothing of it
+# was applied. Judged awake, not by rule: a Warden that lost a task's placement while its link was
+# down can still report it late, honestly.
+[rules.task_claim]
+title = "a Warden's message about a task not placed on its Cell"
+counts = [{ kind = "guard.task_refused", where = { reason = ["another_cell", "unplaced"] } }]
+group_by = "cell"
+window_s = 3600.0
