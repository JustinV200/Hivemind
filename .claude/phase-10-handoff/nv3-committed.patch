+    async def relay(
+        self, handler: SnapshotRequestHandler, request: CellSnapshotRequest | CellRollbackRequest
+    ) -> CellSnapshotReply | CellRollbackReply:
+        """Answer a relay request about this link's own Cell; refuse, and record, any other.
+
+        Args:
+            handler: Snapshots or rolls back a Cell the Queen's lifecycle tracks.
+            request: What the link's Warden asked, naming the Cell to snapshot or roll back.
+
+        Returns:
+            The handler's own reply, or an error reply naming no more than the request did.
+        """
+        # The Cell the handshake proved is the only one this link may act on (module docstring).
+        if request.cell_id == self._cell_id:
+            if isinstance(request, CellSnapshotRequest):
+                return await handler.snapshot(request)
+            return await handler.rollback(request)
+        await self._record(RELAY_REFUSED_KIND, SegmentRefusal.ANOTHER_CELL.value)
