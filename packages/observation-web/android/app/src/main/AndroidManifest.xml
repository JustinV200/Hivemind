<?xml version="1.0" encoding="utf-8"?>
<!--
  The Observation Hive APK's manifest (roadmap 12.12, ADR-0047).

  What: one activity (Capacitor's bridge) that the system can start for the launcher icon, for an
  App Link on the Entrance's `/enrol` (the invite link `<base>/enrol#code=<code>`), and for the
  share sheet (text, images, audio); a UnifiedPush receiver; and the few permissions the phone
  client needs.

  Why: the phone is an enrolled device like any other and holds no privilege beyond the Landing
  Board's. So there is no location, contacts, storage or Google services permission, no foreground
  service and no Firebase; push rides UnifiedPush and a distributor the operator chose.

  Invariants:
    - The App Link host is the `entranceHost` manifest placeholder, set at build time from the
      Gradle property `hiveEntranceHost` (see app/build.gradle and android/README.md). It must be
      the Entrance's DNS name, the same name the passkey's relying party uses.
    - allowBackup is off: the session's binding key and token must not be copied to a cloud backup.
    - Only the activity and the push receiver are exported, both because the system must reach them.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Link: the invite link opens here, so the join screen runs in the app. When the
                 link does not verify, Android opens it in the browser and the code is typed by hand. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${entranceHost}" android:path="/enrol" />
            </intent-filter>

            <!-- Share targets: text, images and audio from any app, confirmed in the app before sending. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>

        </activity>

        <!-- UnifiedPush: the distributor sends endpoints and pushes here, even while the app is closed. -->
        <receiver
            android:name=".push.PushReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Lets the app find installed UnifiedPush distributors (package visibility, Android 11+). -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push-to-talk records through the WebView's MediaRecorder. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Push notices and the ongoing "a question is waiting" notification (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
